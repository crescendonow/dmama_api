# PostgreSQL 9.4 + PostGIS — existing read-only spatial queries (16 endpoints)
DATABASE_URL=postgres://user:password@localhost:5432/dbname?sslmode=disable

# PostgreSQL 16 + PostGIS — feature CRUD topology engine + dmama_layer backup mirror.
# Leave empty to disable the feature CRUD endpoints (the server still serves the read endpoints).
GISDATA_URL=postgres://dmama:password@10.250.230.81:5432/gis_data?sslmode=prefer

# HTTP server port
PORT=5013

# Allowed CORS origins (comma-separated, or * for all)
CORS_ORIGINS=*

# API key required in X-API-Key header (leave empty to disable auth in dev)
DMAMA_KEY=

# Vallaris MongoDB — feature store (source of truth). Leave MONGO_URI empty to disable feature CRUD.
# The same cluster also hosts the user directory database (MONGO_USERS_DB).
MONGO_URI=mongodb://user:password@host1:27017,host2:27018,host3:27019/admin?replicaSet=rs0&authSource=admin
MONGO_DB=vallaris_feature

# User directory database/collection used to resolve _createdBy/_updatedBy.
# The X-User-Id request header (e.g. 10090) is combined with USER_DOMAIN into a username
# (10090@pwa.co.th) and looked up in <MONGO_USERS_DB>.users by the `username` field.
MONGO_USERS_DB=claystone
USER_DOMAIN=pwa.co.th

# ObjectId hex used for _createdBy/_updatedBy when there is no X-User-Id header or the user
# is not found in the directory (optional)
SYSTEM_USER_ID=
